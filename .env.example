# Database
DATABASE_URL=postgresql://dejoiy:dejoiy_secret@localhost:5432/dejoiy_codeagent

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# OpenAI (set via Settings UI or here for server defaults)
OPENAI_API_KEY=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Workspace storage
WORKSPACE_ROOT=/workspace/workspaces

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
